{
  "mappings": [
    {
      "name": "coreflow: internal payment executed",
      "priority": 5,
      "request": { "method": "POST", "urlPath": "/api/payments/internal" },
      "response": {
        "status": 201,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "data": { "paymentId": "pay-7c21", "state": "EXECUTED" } }
      }
    },
    {
      "name": "coreflow: payment of 10'000.00 or more is refused for insufficient funds",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/api/payments/internal",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.instructedAmount.value", "matches": "^[0-9]{5,}(\\.[0-9]+)?$" } } ]
      },
      "response": {
        "status": 400,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"faults\": [{\"faultCode\": \"CF-2201\", \"detail\": \"Insufficient funds\", \"ref\": \"{{jsonPath request.body '$.debtor.accountId'}}\"}]}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "coreflow: payment to an unknown account",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/api/payments/internal",
        "bodyPatterns": [ { "matchesJsonPath": "$[?(@.creditor.accountId == 'cf-acc-9999')]" } ]
      },
      "response": {
        "status": 400,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "faults": [ { "faultCode": "CF-1404", "detail": "Creditor account does not exist", "ref": "cf-acc-9999" } ] }
      }
    }
  ]
}
