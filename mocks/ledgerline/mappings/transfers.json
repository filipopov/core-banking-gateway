{
  "mappings": [
    {
      "name": "ledgerline: transfer booked",
      "priority": 5,
      "request": { "method": "POST", "urlPath": "/v3/transfers" },
      "response": {
        "status": 201,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "transfer_id": "LTR-80001", "status": "BOOKED" }
      }
    },
    {
      "name": "ledgerline: transfer of 10'000.00 or more is refused for insufficient funds",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/v3/transfers",
        "bodyPatterns": [ { "matchesJsonPath": { "expression": "$.amount_minor", "matches": "^[0-9]{7,}$" } } ]
      },
      "response": {
        "status": 422,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"error\": {\"code\": \"INSUFFICIENT_FUNDS\", \"message\": \"Available balance too low\", \"account_id\": \"{{jsonPath request.body '$.from_account_id'}}\"}}",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "ledgerline: transfer to an unknown account",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/v3/transfers",
        "bodyPatterns": [ { "matchesJsonPath": "$[?(@.to_account_id == 'LL-9999')]" } ]
      },
      "response": {
        "status": 404,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "error": { "code": "ACCOUNT_NOT_FOUND", "message": "Creditor account unknown", "account_id": "LL-9999" } }
      }
    }
  ]
}
